{
  "name": "belgrano-cafe",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:record": "cypress run --record",
    "test:e2e": "start-server-and-test preview http://localhost:4173 cypress:run",
    "test:e2e:ci": "start-server-and-test preview http://localhost:4173 cypress:run",
    "test:e2e:cloud": "start-server-and-test preview http://localhost:4173 cypress:record",
    "verify:all": "npm run typecheck && npm run test:unit && npm run test:integration && npm run build && npm run test:e2e:ci",
    "test:unit": "vitest run src/test/unit",
    "test:integration": "vitest run src/test/integration"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "cypress": "^13.17.0",
    "jsdom": "^25.0.1",
    "start-server-and-test": "^2.0.10",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
